

# 선택 — 기본값은 application.properties 참고 (로컬 MySQL 기본 세팅이면 생략 가능)
DB_URL=jdbc:mysql://localhost:3306/mcm_onboarding?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=root

# 필수 — MySQL 접속 비밀번호
DB_PASSWORD=

# 선택 — 비워두면 LlmWebClient가 더미 응답만 반환
#LLM_API_KEY=

# 필수 — 관리자 API(/admin/**) 호출 시 X-Admin-Key 헤더로 넘길 고정 키
ADMIN_KEY=

# 선택 — QR코드에 인코딩할 URL 템플릿. {tagCode}가 실제 태그코드로 치환됨.
# 비워두면 QR에 tagCode 원문만 인코딩됨. 프론트 배포 후 실제 도메인으로 설정.
QR_URL_TEMPLATE=
